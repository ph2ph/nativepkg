# This file was autogenerated by nativepkg {{ generator_version }}

[Unit]
Description={{ package_description }}
# Wants= plus After= gives the dependency and the ordering; a bare Requires= orders nothing.
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User={{ user }}
Group={{ group }}
EnvironmentFile=/etc/default/{{ package_name }}
WorkingDirectory={{ install_dir }}/{{ package_name }}
ExecStart={{ install_dir }}/{{ package_name }}/app/{{ daemon_entrypoint }}
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5

# Hardening. A service that needs more can ship its own unit template.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ReadWritePaths=/var/log/{{ package_name }}

[Install]
WantedBy=multi-user.target
