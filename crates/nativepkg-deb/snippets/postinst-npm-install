if [ "$1" = "configure" ]; then
	# The manifest lives under app/, so the manager must run there.
	# Runs as root, so never runs install hooks. A host without the manager or network gets a
	# warning, not a package state dpkg refuses to remove.
	if command -v {{ install_binary }} >/dev/null 2>&1; then
		( cd '{{ install_dir }}/{{ package_name }}/app' && {{ install_command }} ) || echo 'WARNING: dependency install failed; dependencies may be missing' >&2
	else
		echo 'WARNING: {{ install_binary }} is not on the path; dependencies are missing' >&2
	fi
fi
