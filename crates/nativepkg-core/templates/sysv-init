#!/bin/sh
# Start/stop the {{ package_name }} daemon.
# This file was autogenerated by nativepkg {{ generator_version }}
#
### BEGIN INIT INFO
# Provides:          {{ package_name }}
# Required-Start:    $remote_fs $syslog $network
# Required-Stop:     $remote_fs $syslog $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Description: {{ package_description }}
### END INIT INFO

set -u

SCRIPT="{{ install_dir }}/{{ package_name }}/app/{{ daemon_entrypoint }}"
USER="{{ user }}"
NAME="{{ package_name }}"
WORKING_DIRECTORY="{{ install_dir }}/{{ package_name }}"
DESCRIPTION="{{ package_description_shell }}"

. /lib/lsb/init-functions

# The defaults file is configuration: an administrator may delete it, and no package manager
# restores a file that was deliberately removed. Sourcing it unconditionally makes this script
# fail outright when that happens, taking the service down for a file it does not need.
[ -r "/etc/default/{{ package_name }}" ] && . "/etc/default/{{ package_name }}"

LOGDIR="/var/log/{{ package_name }}"
LOGFILE="$LOGDIR/${NODE_ENV:-development}.log"

mkdir -p "$LOGDIR"
chown -R "{{ user }}:{{ group }}" "$LOGDIR"

do_start() {
  start-stop-daemon --start \
    --user "$USER" --chuid "$USER" \
    --background --chdir "$WORKING_DIRECTORY" \
    --startas "/bin/sh" -- -c "exec $SCRIPT >> $LOGFILE 2>&1"
}

do_stop() {
  start-stop-daemon --stop \
    --user "$USER" --chuid "$USER" \
    --retry=5
}

do_status() {
  start-stop-daemon --status \
    --user "$USER" --chuid "$USER"
}

case "$1" in
  start)
    log_daemon_msg "Starting $DESCRIPTION" "$NAME"
    do_start
    case "$?" in
      0)
        log_end_msg 0
        ;;
      1)
        log_progress_msg "already started"
        log_end_msg 0
        ;;
      *)
        log_end_msg 1
        ;;
    esac
    ;;
  stop)
    log_daemon_msg "Stopping $DESCRIPTION" "$NAME"
    do_stop
    case "$?" in
      0)
        log_end_msg 0
        ;;
      1)
        log_progress_msg "already stopped"
        log_end_msg 0
        ;;
      *)
        log_end_msg 1
        ;;
    esac
    ;;
  restart|force-reload)
    $0 stop
    $0 start
    ;;
  try-restart)
    $0 status >/dev/null 2>&1 && $0 restart
    ;;
  status)
    do_status
    status="$?"
    case "$status" in
      0)
        log_success_msg "$NAME is running"
        ;;
      4)
        log_failure_msg "status of $NAME could not be determined"
        ;;
      *)
        log_failure_msg "$NAME is not running"
        ;;
    esac
    exit "$status"
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|force-reload|try-restart|status}" >&2
    exit 3
    ;;
esac
