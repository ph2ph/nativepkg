if [ "$1" = "remove" ]; then
	if [ -x /usr/bin/deb-systemd-helper ]; then
		deb-systemd-helper mask '{{ package_name }}.service' >/dev/null || true
	fi
fi

if [ "$1" = "purge" ]; then
	if [ -x /usr/bin/deb-systemd-helper ]; then
		deb-systemd-helper purge '{{ package_name }}.service' >/dev/null || true
		deb-systemd-helper unmask '{{ package_name }}.service' >/dev/null || true
	fi
fi
